{
  "expo": {
    "name": "epub-reader",
    "slug": "epub-reader",
    "version": "1.0.0",
    "orientation": "default",
    "backgroundColor": "#000000",
    "icon": "./assets/images/icon_demo.png",
    "scheme": "epubreader",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "MANAGE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon_demo.png"
      },
      "statusBar": {
        "translucent": false,
        "backgroundColor": "#000000",
        "barStyle": "light-content"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.keremalpdemiroz.epubreader"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon_demo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon_demo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "323f8ad6-e827-4fe5-bcb3-e89e483179ec"
      }
    }
  }
}
